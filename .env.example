# Copy to .env and fill in your existing local database/model settings.
POSTGRES_USER=ai4i_user
POSTGRES_PASSWORD=replace_with_your_local_password
POSTGRES_DB=ai4i_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
MODEL_NAME=AI4I_Predictive_Maintenance
MODEL_VERSION=
MLFLOW_TRACKING_URI=http://127.0.0.1:5001
# Optional API container connects to the existing host MLflow server.
DOCKER_MLFLOW_TRACKING_URI=http://host.docker.internal:5001
# scripts/setup_grafana.py creates separate ignored .env.monitoring secrets.
